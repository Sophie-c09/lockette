NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Used by src/app/actions/auth.ts's requestPasswordReset to build
# the redirectTo URL a password-reset email links back to — defaults to
# the real production domain (https://lockette.org) when unset, so
# production never needs this var at all. Only set this locally (e.g. to
# http://localhost:3000) if you're testing the forgot-password flow
# against a real Supabase project from local dev — whatever value you use
# must also be added to that project's Authentication -> URL Configuration
# -> Redirect URLs allow-list, or Supabase rejects the link.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Apple (src/app/actions/auth.ts's signInWithApple) needs NO
# application env var at all — the Apple Services ID, Team ID, Key ID,
# and generated client secret are configured entirely in the Supabase
# dashboard (Authentication -> Providers -> Apple). Google Sign-In works
# the same way already. See this feature's own setup docs for the exact
# Apple Developer / Supabase steps.

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses RLS; used by
# /admin/import to save listings (Settings → API in the Supabase dashboard).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Used by /admin/import to classify listings (category, color,
# aesthetic tags, style era, fit) after extraction. Optional — if unset,
# imports still work, just without AI classification (see
# src/lib/listing-classification.ts).
OPENAI_API_KEY=your-openai-api-key
# Optional override, defaults to gpt-4o-mini.
# OPENAI_CLASSIFICATION_MODEL=gpt-4o-mini

# Server-only. Used by src/lib/stripe.ts and every real Stripe call in
# src/lib/payment.ts (PaymentIntent creation) and the webhook receiver at
# src/app/api/stripe/webhook/route.ts. Use a *test-mode* secret key
# (sk_test_...) for local dev and staging — never a live key
# (sk_live_...) outside production. checkout-payment.ts fails with a
# clear, safe server error (never a raw stack trace) if this is unset —
# see requireStripeConfig() in src/lib/stripe.ts.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# or the webhook endpoint's settings in the Stripe dashboard. Required for
# the webhook route to accept events — without it, every request is
# rejected with 400 rather than trusting an unverified payload. This is
# the ONLY source of truth the webhook route accepts for "this event
# really came from Stripe" — never skip verification, even temporarily.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Public — safe to expose to the browser (this is what it's for). Used by
# src/lib/stripe-client.ts to load Stripe.js for the checkout page's
# Payment Element (card entry, Apple Pay, Google Pay). Must be the
# publishable key from the SAME Stripe account/mode (test vs live) as
# STRIPE_SECRET_KEY above — a mismatched pair fails every PaymentIntent
# confirmation with an "No such payment_intent" style error.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Server-only. Checked by src/app/api/cron/check-listing-status/route.ts
# against the Authorization header Vercel Cron sends (see vercel.json) —
# required for the route to accept a request; without it, every request
# (including Vercel's own) is rejected with 401. Vercel sets this
# automatically as `Authorization: Bearer <value>` for any route listed in
# vercel.json's `crons`, as long as this env var is also set in the
# deployment's project settings — generate any random secret string.
CRON_SECRET=your-cron-secret
